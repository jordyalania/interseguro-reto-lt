server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Con variables, nginx vuelve a resolver el DNS en vez de fijar la IP al arrancar.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
    set $endorsement_api "${ENDORSEMENT_API_URL}";
    set $routing_api "${ROUTING_API_URL}";

    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'" always;

    location /api/v1/routes/ {
        proxy_pass $routing_api;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Request-Id $request_id;
        proxy_ssl_server_name on;
    }

    location /api/v1/ {
        proxy_pass $endorsement_api;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Request-Id $request_id;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri /index.html;
    }
}
