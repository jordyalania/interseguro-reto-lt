<mxfile host="app.diagrams.net"><diagram name="Vista simple" id="to-be-simple"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title0" value="Propuesta: pedir dos veces ya no paga dos veces" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1250" height="24" as="geometry"/></mxCell><mxCell id="title1" value="Azul: el cliente. Amarillo: se modifica. Verde: es nuevo. Sigue los números." style="text;html=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="20" y="28" width="1250" height="24" as="geometry"/></mxCell><mxCell id="z1" value="Google Cloud (Zona Segura)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f2f8f4;strokeColor=#8fb79f;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="750" height="400" as="geometry"/></mxCell><mxCell id="z2" value="Sistemas internos" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f7f2;strokeColor=#a3ad8a;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="230" height="400" as="geometry"/></mxCell><mxCell id="client" value="Cliente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4a7fc1;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="120" height="76" as="geometry"/></mxCell><mxCell id="api" value="API de préstamos&lt;br&gt;Responde &quot;recibido&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="180" height="76" as="geometry"/></mxCell><mxCell id="queue" value="Cola de mensajes&lt;br&gt;(Pub/Sub)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="160" height="76" as="geometry"/></mxCell><mxCell id="worker" value="Procesador&lt;br&gt;Atiende a ritmo seguro" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="190" height="76" as="geometry"/></mxCell><mxCell id="admwr" value="admwr-api&lt;br&gt;Acepta el número único" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="190" height="76" as="geometry"/></mxCell><mxCell id="bank" value="Banco&lt;br&gt;Desembolso" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="130" width="130" height="76" as="geometry"/></mxCell><mxCell id="db" value="Base de operaciones&lt;br&gt;Número único y estado" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="320" width="180" height="90" as="geometry"/></mxCell><mxCell id="reconciler" value="Conciliador&lt;br&gt;Resuelve los casos dudosos" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="320" width="190" height="90" as="geometry"/></mxCell><mxCell id="tauro" value="TAURO&lt;br&gt;Rechaza duplicados" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="320" width="190" height="90" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Idea 1: el cliente no espera&lt;/b&gt;&lt;br&gt;Recibe &quot;solicitud recibida&quot; al instante y consulta el estado en&lt;br&gt;   pantalla." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f7f9fb;strokeColor=#9fb0bd;fontColor=#17222b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="420" height="77.0" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Idea 2: cada solicitud tiene un número único&lt;/b&gt;&lt;br&gt;Si llega repetida, se devuelve la que ya existe. La base de&lt;br&gt;   operaciones y TAURO lo garantizan." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f7f9fb;strokeColor=#9fb0bd;fontColor=#17222b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="450" height="77.0" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Idea 3: ante la duda, primero se pregunta&lt;/b&gt;&lt;br&gt;Si hay error o demora, no se reenvía. El conciliador consulta qué&lt;br&gt;   pasó y actualiza el estado." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f7f9fb;strokeColor=#9fb0bd;fontColor=#17222b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="940" y="500" width="430" height="77.0" as="geometry"/></mxCell><mxCell id="e0" value="1. Pide y&lt;br&gt;consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="api"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="2. Guarda" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="db"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="3. Encola" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="queue"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="4. Entrega" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="queue" target="worker"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="5. Envía" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#1f8a55;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="admwr"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="6. Registra&lt;br&gt;una vez" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="admwr" target="tauro"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="7. Paga" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="admwr" target="bank"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Pregunta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;strokeColor=#1f8a55;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="reconciler" target="admwr"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="347"/><mxPoint x="945" y="191"/></Array></mxGeometry></mxCell><mxCell id="e8" value="Actualiza el estado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="reconciler" target="db"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Detalle" id="to-be-detalle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1597" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title0" value="Propuesta (TO-BE): Préstamos asíncronos sin desembolsos duplicados" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1250" height="24" as="geometry"/></mxCell><mxCell id="title1" value="El cliente deja de depender de INARI y cada operación se reconoce en toda la cadena. Los números siguen el recorrido de una solicitud." style="text;html=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="20" y="28" width="1250" height="24" as="geometry"/></mxCell><mxCell id="title2" value="Estados de una operación: lo que ve el cliente y lo que decide cada reintento" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="20" y="1365" width="1250" height="24" as="geometry"/></mxCell><mxCell id="z1" value="GCP: Zona Segura" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f2f8f4;strokeColor=#8fb79f;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="1160" height="490" as="geometry"/></mxCell><mxCell id="z2" value="IS-VCE: VMware INARI, TAURO y SFTP (por la conexión privada existente)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f7f2;strokeColor=#a3ad8a;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="290" y="610" width="1160" height="460" as="geometry"/></mxCell><mxCell id="z3" value="Servicios externos y bancos" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ececec;strokeColor=#a8a8a8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="1480" y="610" width="260" height="460" as="geometry"/></mxCell><mxCell id="lg1" value="Se mantiene" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1420" y="12" width="100" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="Se modifica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1530" y="12" width="100" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="Es nuevo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1640" y="12" width="100" height="30" as="geometry"/></mxCell><mxCell id="client" value="Clientes de&lt;br&gt;Renta Particular" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4a7fc1;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="106" width="120" height="64" as="geometry"/></mxCell><mxCell id="proxy1" value="Proxy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="106" width="80" height="64" as="geometry"/></mxCell><mxCell id="front" value="Portal Zona Segura&lt;br&gt;(zona-segura-frontend)&lt;br&gt;Muestra &quot;en proceso&quot;&lt;br&gt;y consulta el estado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="200" height="96" as="geometry"/></mxCell><mxCell id="back" value="API de préstamos&lt;br&gt;(zona-segura-backend)&lt;br&gt;Responde 202 y ya&lt;br&gt;no llama a INARI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="200" height="96" as="geometry"/></mxCell><mxCell id="pubsub" value="Cola de mensajes&lt;br&gt;(Pub/Sub)&lt;br&gt;loan-disbursement" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="170" height="96" as="geometry"/></mxCell><mxCell id="worker" value="Procesador de desembolsos&lt;br&gt;(loan-worker en Cloud Run)&lt;br&gt;Barrera 2: toma atómica&lt;br&gt;Concurrencia limitada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="210" height="96" as="geometry"/></mxCell><mxCell id="portal" value="Base de operaciones&lt;br&gt;(portal-db)&lt;br&gt;Operación + bandeja de salida&lt;br&gt;Barrera 1: índice único" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="200" height="110" as="geometry"/></mxCell><mxCell id="dlq" value="Cola de fallidos (DLQ)&lt;br&gt;Mensajes que agotaron&lt;br&gt;sus reintentos" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="270" width="170" height="80" as="geometry"/></mxCell><mxCell id="sweeper" value="Reenvío de pendientes&lt;br&gt;(Cloud Scheduler + Job)&lt;br&gt;Cubre una caída tras guardar" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="285" width="200" height="80" as="geometry"/></mxCell><mxCell id="reconciler" value="Conciliador&lt;br&gt;(Cloud Scheduler + Job)&lt;br&gt;Resuelve las operaciones&lt;br&gt;en estado UNKNOWN" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1200" y="270" width="210" height="96" as="geometry"/></mxCell><mxCell id="monitor" value="Monitoreo y alertas&lt;br&gt;(Cloud Monitoring)&lt;br&gt;UNKNOWN vencidos y DLQ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="925" y="440" width="200" height="84" as="geometry"/></mxCell><mxCell id="secrets" value="Secretos y permisos&lt;br&gt;(Secret Manager e IAM)&lt;br&gt;Acceso mínimo por servicio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="200" height="70" as="geometry"/></mxCell><mxCell id="ops" value="Equipo de&lt;br&gt;Operaciones" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#4a7fc1;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="120" height="64" as="geometry"/></mxCell><mxCell id="proxy2" value="Proxy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="680" width="80" height="64" as="geometry"/></mxCell><mxCell id="admwr" value="Consola ADMWR (.NET Forms)&lt;br&gt;Bandeja de revisión manual" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="670" width="200" height="84" as="geometry"/></mxCell><mxCell id="admapi" value="admwr-api&lt;br&gt;Registro idempotente y&lt;br&gt;consulta por operationId" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="660" width="200" height="104" as="geometry"/></mxCell><mxCell id="tauro" value="Base de préstamos&lt;br&gt;(SQL Server en TAURO)&lt;br&gt;Barrera 3: índices únicos&lt;br&gt;operationId y póliza + cronograma" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1160" y="650" width="250" height="124" as="geometry"/></mxCell><mxCell id="ultapi" value="ultimus-api&lt;br&gt;Incidente de pago idempotente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="840" width="200" height="76" as="geometry"/></mxCell><mxCell id="sftp" value="Servidor SFTP S42VP&lt;br&gt;Tramas ASBANC&lt;br&gt;Barrera 4: control de duplicados" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1160" y="950" width="250" height="90" as="geometry"/></mxCell><mxCell id="ultimus" value="ULTIMUS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1525" y="670" width="170" height="60" as="geometry"/></mxCell><mxCell id="exactus" value="EXACTUS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1525" y="790" width="170" height="60" as="geometry"/></mxCell><mxCell id="banks" value="SFTP de los bancos&lt;br&gt;Desembolso real" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7c88;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1525" y="965" width="170" height="60" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Cómo se lee: flujo normal, paso a paso&lt;/b&gt;&lt;br&gt;1. El cliente solicita el préstamo con un identificador de operación (operationId).&lt;br&gt;2. La API guarda la operación en estado PENDING y su mensaje en la bandeja de salida,&lt;br&gt;   de una sola vez.&lt;br&gt;3. Responde 202 (&quot;recibido&quot;) y publica el mensaje. El cliente ya no espera a INARI y&lt;br&gt;   consulta el estado.&lt;br&gt;4. La cola entrega el mensaje al procesador.&lt;br&gt;5. El procesador toma la operación: pasa de PENDING a PROCESSING. Solo uno puede&lt;br&gt;   lograrlo.&lt;br&gt;6. Envía la solicitud a admwr-api con el mismo operationId.&lt;br&gt;7. admwr-api guarda primero el operationId, confirma, y después procesa.&lt;br&gt;8. Genera el incidente de pago en ULTIMUS.&lt;br&gt;9. Genera la trama, una sola vez por operación.&lt;br&gt;10. El banco desembolsa y el cliente ve COMPLETED." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f7f9fb;strokeColor=#9fb0bd;fontColor=#17222b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="1095" width="560" height="247.5" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Cuatro barreras contra el duplicado&lt;/b&gt;&lt;br&gt;Barrera 1, base de operaciones: un índice único reconoce los reintentos del cliente&lt;br&gt;   y otra pestaña para la misma póliza y cronograma.&lt;br&gt;Barrera 2, procesador: la toma atómica impide que dos procesos atiendan la misma&lt;br&gt;   operación.&lt;br&gt;Barrera 3, TAURO: índices únicos que rechazan el duplicado justo donde se registra&lt;br&gt;   el préstamo.&lt;br&gt;Barrera 4, SFTP: última revisión para no enviar dos veces una operación a los&lt;br&gt;   bancos.&lt;br&gt;Por qué en cuatro puntos: si una barrera falla o alguien llama por otro camino, la&lt;br&gt;   siguiente sigue protegiendo el dinero." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f7f9fb;strokeColor=#9fb0bd;fontColor=#17222b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="1095" width="540" height="201.0" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Qué pasa si algo falla&lt;/b&gt;&lt;br&gt;- El cliente reintenta: recibe la misma operación, no crea otra.&lt;br&gt;- La cola entrega dos veces: solo un procesador toma la operación.&lt;br&gt;- Se cae el proceso tras guardar: el reenvío publica lo pendiente.&lt;br&gt;- Fallo antes de enviar a INARI: vuelve a PENDING, reintentar es seguro.&lt;br&gt;- 502 o timeout: pasa a UNKNOWN y NO se reintenta a ciegas.&lt;br&gt;- UNKNOWN: el conciliador consulta por operationId y decide. Como la fila se guarda antes&lt;br&gt;   de procesar, ve lo que sigue en curso.&lt;br&gt;- No existe tras la ventana de espera: se reenvía con el mismo operationId, sin riesgo de&lt;br&gt;   duplicar.&lt;br&gt;- Sin resolver: se alerta y pasa a revisión manual de Operaciones." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f7f9fb;strokeColor=#9fb0bd;fontColor=#17222b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="1095" width="580" height="201.0" as="geometry"/></mxCell><mxCell id="s1" value="PENDING&lt;br&gt;Guardada, en espera" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef1fb;strokeColor=#5b6bbf;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="1427" width="170" height="56" as="geometry"/></mxCell><mxCell id="s2" value="PROCESSING&lt;br&gt;En manos del procesador" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef1fb;strokeColor=#5b6bbf;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="1427" width="180" height="56" as="geometry"/></mxCell><mxCell id="s3" value="COMPLETED&lt;br&gt;Desembolso confirmado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcf5e8;strokeColor=#1f8a55;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="1419" width="180" height="50" as="geometry"/></mxCell><mxCell id="s4" value="FAILED&lt;br&gt;Rechazo definitivo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#c0362c;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="1485" width="180" height="50" as="geometry"/></mxCell><mxCell id="s5" value="UNKNOWN&lt;br&gt;Resultado incierto: no reintentar" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="1427" width="220" height="56" as="geometry"/></mxCell><mxCell id="s6" value="MANUAL_REVIEW&lt;br&gt;Lo resuelve Operaciones" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#17222b;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="1427" width="200" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="proxy1"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy1" target="front"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="1. Solicita y&lt;br&gt;consulta estado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="front" target="back"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="2. Guarda de&lt;br&gt;una sola vez" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="back" target="portal"><mxGeometry x="-0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="3. Publica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="back" target="pubsub"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="4. Entrega" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pubsub" target="worker"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Reintentos agotados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pubsub" target="dlq"><mxGeometry x="-0.56" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Reenvía&lt;br&gt;pendientes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweeper" target="portal"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="5. Toma la operación&lt;br&gt;(PENDING a PROCESSING)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="portal"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1225.2" y="232"/><mxPoint x="880" y="232"/><mxPoint x="880" y="325"/></Array></mxGeometry></mxCell><mxCell id="e9" value="Actualiza el estado final" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.775;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="reconciler" target="portal"><mxGeometry x="0.44" relative="1" as="geometry"><Array as="points"><mxPoint x="1242" y="412"/><mxPoint x="795" y="412"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dlq" target="monitor"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Alerta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="reconciler" target="monitor"><mxGeometry x="0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="6. Envía con el operationId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#1f8a55;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="admapi"><mxGeometry x="0.24" relative="1" as="geometry"><Array as="points"><mxPoint x="1425" y="138"/><mxPoint x="1425" y="584"/><mxPoint x="800" y="584"/></Array></mxGeometry></mxCell><mxCell id="e13" value="Consulta por operationId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;strokeColor=#1f8a55;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reconciler" target="admapi"><mxGeometry x="0.48" relative="1" as="geometry"><Array as="points"><mxPoint x="1438" y="318"/><mxPoint x="1438" y="566"/><mxPoint x="730" y="566"/></Array></mxGeometry></mxCell><mxCell id="e14" value="7. Guarda el operationId, confirma y luego procesa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="admapi" target="tauro"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="8. Incidente de pago" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#47586a;strokeWidth=1.5;fontSize=11;fontColor=#17222b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="admapi" target="ultapi"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="9. Genera la trama" style="edgeStyle=orth